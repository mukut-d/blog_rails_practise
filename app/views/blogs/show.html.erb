<div class="show-page">
  <%= link_to("Back", blogs_path) %> <br>
  <h1>Show Articles</h1>
  <p>In this Page you can see your articles</p>
  <div class="actions">
    <%= link_to('Edit', edit_blog_path(@article)) %> <br>
    <%= link_to("Delete", blog_path(@article.id), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }) %> <br> <br>
  </div>
  <table>
    <tr>
      <th>ID</th>
      <th>Article</th>
      <th>Description</th>
      <th>created_at</th>
      <th>updated_at</th>
    </tr>
    <tr>
      <td><%= @article.position %></td>
      <td><%= @article.name %></td>
      <td><%= @article.description %></td>
      <td><%= @article.created_at %></td>
      <td><%= @article.updated_at %></td>
    </tr>
  </table>
</div>