<%= link_to("Back", blogs_path)%> <br>


<h1>Delete Articles</h1>
<p>In this Page you can delete your articles</p>

<div>
  <h2>Delete Article</h2>

  <%= form_for(@article, url: blog_path(@article), method: 'delete') do |f| %>
    <% # url: task_path(@task), method: 'patch' %>

    <%= render(partial: 'form', locals: {f: f}) %>

    <div class="form-buttons">
      <%= f.submit("Delete Task") %>
    </div>

  <% end %>
</div>