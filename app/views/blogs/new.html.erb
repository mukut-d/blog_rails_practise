<div class="new-page">
  <%= link_to("Back", blogs_path) %> <br>
  <h1>Create Blogs</h1>
  
  <p>You can create new blogs here.</p>
  <% full_name = @name + " " + @last_name %>
  <%= full_name %> <br>
  
  <h2>Create Articles</h2>
  <%= form_for(@article, url: blogs_path) do |f| %>
    <%= render(partial: 'form', locals: { f: f }) %>
  <% end %>
</div>
